# Copy to .env and fill in real values. NEVER commit .env.
#
# Everything except the VITE_ block is server-side only. The VITE_ names are
# compiled into the browser bundle and must therefore hold public values only:
# a publishable key, not a secret key.
#
# After editing the server-side values, push them to Supabase with:
#   python scripts/deploy-secrets.py

RESEND_API_KEY=replace_me
RESEND_FROM_EMAIL=billing@example.com
SMS_PROVIDER=infobip
INFOBIP_API_KEY=replace_me
INFOBIP_BASE_URL=https://<account>.api.infobip.com
INFOBIP_SENDER=+10000000000
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+10000000000
LLM_PROVIDER=openai
LLM_API_KEY=replace_me
LLM_MODEL=gpt-4o
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
APP_BASE_URL=https://example.com
SUPABASE_ACCESS_TOKEN=sbp_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# --- Client bundle (PUBLIC - never put a secret below this line) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
VITE_APP_URL=https://example.com
VITE_ENABLE_GOOGLE_AUTH=true
CRON_SECRET=replace_me
